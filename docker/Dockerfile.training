# =============================================================================
# Dockerfile.training – Training container for GB10 (ARM64 + CUDA 13 + SM_121)
# =============================================================================
# MUSS das NGC PyTorch Image nutzen – einzige Quelle für SM_121-kompatibles
# PyTorch. Wir pinnen nur peft auf eine Version ohne torchao-Abhängigkeit.
# =============================================================================

FROM nvcr.io/nvidia/pytorch:25.11-py3

LABEL maintainer="text2sql-finetune-pipeline"
LABEL description="Training container for Text-to-SQL finetuning (ARM64/GB10/SM_121)"

# ---------------------------------------------------------------------------
# System dependencies
# ---------------------------------------------------------------------------
RUN apt-get update && apt-get install -y --no-install-recommends \
    git \
    curl \
    ninja-build \
    && ln -sf /usr/bin/python3 /usr/bin/python \
    && rm -rf /var/lib/apt/lists/*

# ---------------------------------------------------------------------------
# Python dependencies
# ---------------------------------------------------------------------------
WORKDIR /app

COPY docker/requirements_training.txt .

# Deinstalliere problematische Pakete die mit NGC-Versionen kollidieren
RUN pip uninstall -y torchao unsloth unsloth-zoo 2>/dev/null || true

# Installiere peft 0.13.2 – letzte Version OHNE torchao-Abhängigkeit
# Danach transformers, trl, datasets kompatibel mit NGC-Versionen
RUN pip install --no-deps \
    "peft==0.13.2"

RUN pip install \
    "transformers==4.47.0" \
    "trl==0.12.0" \
    "accelerate==1.2.0" \
    "datasets==3.2.0" \
    "huggingface-hub==0.27.0" \
    "sentencepiece" \
    "pyyaml" \
    "tqdm" \
    "tensorboard"

# training-hub installieren (ohne cuda extras – PyTorch kommt vom NGC Image)
RUN pip install training-hub

RUN pip install -r requirements_training.txt

# ---------------------------------------------------------------------------
# Copy project code
# ---------------------------------------------------------------------------
COPY . .

# ---------------------------------------------------------------------------
# Directories
# ---------------------------------------------------------------------------
RUN mkdir -p /app/data/final/checkpoints /app/logs

# ---------------------------------------------------------------------------
# Environment
# ---------------------------------------------------------------------------
ENV HF_HOME=/root/.cache/huggingface
ENV TRANSFORMERS_CACHE=/root/.cache/huggingface
ENV PYTHONPATH=/app
ENV PYTHONUNBUFFERED=1
ENV PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True
ENV TORCH_CUDA_ARCH_LIST="12.0"

# ---------------------------------------------------------------------------
# Entrypoint
# ---------------------------------------------------------------------------
CMD ["python3", "training_pipeline/train_direct.py", "--config", "config/pipeline_config.yaml"]

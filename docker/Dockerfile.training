# =============================================================================
# Dockerfile.training – Training Hub finetuning container
# =============================================================================
# Built for NVIDIA GB10 (DGX Spark) – ARM64 + CUDA 13.0
#
# CRITICAL: The GB10 uses:
#   - ARM64 (aarch64) CPU – standard x86_64 images throw "exec format error"
#   - CUDA 13.0
#   - Blackwell SM_121 – not supported by generic pip PyTorch wheels
#
# The ONLY correct base image is NVIDIA's official NGC PyTorch container.
# It includes a Blackwell-optimized PyTorch build, Triton 3.5, FlashAttention.
# Do NOT use pytorch/pytorch or pip install torch on this platform.
#
# Reference: https://gist.github.com/RobG-git/fd1739c79e2405eb56032dee7901421e
# =============================================================================

FROM nvcr.io/nvidia/pytorch:25.11-py3

LABEL maintainer="text2sql-finetune-pipeline"
LABEL description="Training Hub LoRA/SFT finetuning for Text-to-SQL (ARM64/GB10/CUDA13)"

# ---------------------------------------------------------------------------
# System dependencies (apt works normally inside the container)
# ---------------------------------------------------------------------------
RUN apt-get update && apt-get install -y --no-install-recommends \
    git \
    curl \
    ninja-build \
    libssl-dev \
    && rm -rf /var/lib/apt/lists/*

# ---------------------------------------------------------------------------
# Python dependencies
# ---------------------------------------------------------------------------
WORKDIR /app

COPY docker/requirements_training.txt .

# Install Training Hub
RUN pip install --upgrade pip && \
    pip install training-hub

# Install ML ecosystem packages
# bitsandbytes: use the version that supports ARM64
RUN pip install \
    datasets \
    huggingface-hub \
    transformers \
    accelerate \
    peft \
    sentencepiece \
    pyyaml \
    tqdm \
    tensorboard

# bitsandbytes ARM64 build (standard pip version is x86 only)
RUN pip install bitsandbytes --prefer-binary || \
    pip install https://github.com/bitsandbytes-foundation/bitsandbytes/releases/download/continuous-release_multi-backend-refactor/bitsandbytes-0.44.1.dev0-py3-none-manylinux_2_24_aarch64.whl || \
    echo "bitsandbytes install failed – QLoRA won't work but LoRA/SFT will"

# unsloth: install without deps to avoid pulling wrong torch
RUN pip install --no-deps unsloth unsloth_zoo || \
    echo "unsloth install failed – falling back to standard LoRA backend"

# remaining requirements
RUN pip install -r requirements_training.txt

# ---------------------------------------------------------------------------
# Copy project code
# ---------------------------------------------------------------------------
COPY . .

# ---------------------------------------------------------------------------
# Directories (mounted as volumes at runtime)
# ---------------------------------------------------------------------------
RUN mkdir -p /app/data/final /app/data/final/checkpoints /app/logs

# ---------------------------------------------------------------------------
# Environment
# ---------------------------------------------------------------------------
ENV HF_HOME=/root/.cache/huggingface
ENV TRANSFORMERS_CACHE=/root/.cache/huggingface
ENV PYTHONPATH=/app
ENV PYTHONUNBUFFERED=1
ENV PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True
# Tell PyTorch the correct SM for GB10 Blackwell
ENV TORCH_CUDA_ARCH_LIST="12.0"

# ---------------------------------------------------------------------------
# Entrypoint
# ---------------------------------------------------------------------------
CMD ["python", "training_pipeline/train.py", "--config", "config/pipeline_config.local.yaml"]

# =============================================================================
# Dockerfile.training – Training container for GB10 (ARM64 + CUDA 13)
# =============================================================================
# Wir nutzen NICHT mehr das NGC PyTorch Image (zu neue/inkompatible Versionen).
# Stattdessen: NVIDIA CUDA base + manuelle Installation mit gepinnten Versionen.
#
# Gepinnte kompatible Versionen:
#   torch:        2.5.1 (stabil, ARM64 wheels verfügbar via NGC index)
#   transformers: 4.47.0
#   peft:         0.13.2 (letzte Version vor torchao-Integration)
#   trl:          0.12.0
#   torchao:      NICHT installiert
# =============================================================================

FROM nvcr.io/nvidia/cuda:13.0.1-cudnn-devel-ubuntu24.04

LABEL maintainer="text2sql-finetune-pipeline"
LABEL description="Training container for Text-to-SQL finetuning (ARM64/GB10)"

# ---------------------------------------------------------------------------
# System dependencies
# ---------------------------------------------------------------------------
RUN apt-get update && apt-get install -y --no-install-recommends \
    python3 \
    python3-pip \
    python3-dev \
    git \
    curl \
    ninja-build \
    libssl-dev \
    && ln -sf /usr/bin/python3 /usr/bin/python \
    && rm -rf /var/lib/apt/lists/*

# ---------------------------------------------------------------------------
# Python dependencies – alle Versionen gepinnt für Kompatibilität
# ---------------------------------------------------------------------------
WORKDIR /app

# Zuerst pip upgraden
RUN pip install --upgrade pip --break-system-packages

# PyTorch für ARM64 + CUDA 13 – von NVIDIA's eigenem Index
RUN pip install --break-system-packages \
    torch \
    torchvision \
    --index-url https://download.pytorch.org/whl/cu124 || \
    pip install --break-system-packages torch torchvision

# ML Stack mit gepinnten Versionen – KEIN torchao, KEIN unsloth
RUN pip install --break-system-packages \
    "transformers==4.47.0" \
    "peft==0.13.2" \
    "trl==0.12.0" \
    "accelerate==1.2.0" \
    "datasets==3.2.0" \
    "huggingface-hub==0.27.0" \
    "bitsandbytes>=0.42.0" \
    "sentencepiece" \
    "pyyaml" \
    "tqdm" \
    "tensorboard"

# ---------------------------------------------------------------------------
# Copy project code
# ---------------------------------------------------------------------------
COPY . .

# ---------------------------------------------------------------------------
# Directories
# ---------------------------------------------------------------------------
RUN mkdir -p /app/data/final/checkpoints /app/logs

# ---------------------------------------------------------------------------
# Environment
# ---------------------------------------------------------------------------
ENV HF_HOME=/root/.cache/huggingface
ENV TRANSFORMERS_CACHE=/root/.cache/huggingface
ENV PYTHONPATH=/app
ENV PYTHONUNBUFFERED=1
ENV PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True

# ---------------------------------------------------------------------------
# Entrypoint
# ---------------------------------------------------------------------------
CMD ["python3", "training_pipeline/train_direct.py", "--config", "config/pipeline_config.yaml"]
